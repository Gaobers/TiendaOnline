@model IEnumerable<Cupone>

@{
    var filtroCodigo = Context.Request.Query["codigo"].ToString();
    var estatus = Context.Request.Query["estatus"].ToString();
    var top = Context.Request.Query["top"].ToString();

    if (string.IsNullOrWhiteSpace(top))
    {
        top = "10";
    }

    var hayFiltrosActivos =
      !string.IsNullOrWhiteSpace(filtroCodigo) ||
      !string.IsNullOrWhiteSpace(estatus) ||
      top != "10";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/pages/cupones/index.css" asp-append-version="true" />
}


<div class="container admin-index-page cupones-index">
    <div class="card admin-hero-card">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h1 class="admin-hero-title">
                    <i class="bi bi-ticket-perforated me-2"></i>Cupones
                </h1>
                <p class="admin-hero-subtitle">
                    Administra descuentos y promociones del sistema.
                </p>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-outline-light admin-btn-main"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#filtrosBusqueda"
                        aria-expanded="@(hayFiltrosActivos ? "true" : "false")"
                        aria-controls="filtrosBusqueda">
                    <i class="bi bi-funnel me-1"></i> Filtros
                </button>

                <a asp-action="Create" class="btn btn-light admin-btn-main">
                    <i class="bi bi-plus-lg me-1"></i> Nuevo cupon
                </a>
            </div>
        </div>
    </div>

    <!-- FILTROS -->
        <div class="collapse @(hayFiltrosActivos ? "show" : "")" id="filtrosBusqueda">
            <div class="card admin-filter-card mt-3">
                <div class="card-body">
                    <form method="get">
                        <div class="row g-3 align-items-end">

                        <!-- CODIGO -->
                        <div class="col-12 col-md-6 col-xl-3">
                            <label class="form-label admin-filter-label">Código</label>
                            <div class="input-group shadow-sm admin-filter-group">
                                <span class="input-group-text bg-white">
                                    <i class="bi bi-tag text-primary"></i>
                                </span>
                                <input type="text"
                                       name="codigo"
                                       class="form-control"
                                       placeholder="Ej: PROMO10"
                                       value="@filtroCodigo" />
                            </div>
                        </div>

                        <!-- ESTATUS -->
                            <div class="col-12 col-md-4 col-xl-2">
                                <label class="form-label admin-filter-label">Estado</label>
                                <div class="input-group shadow-sm admin-filter-group">
                                    <span class="input-group-text bg-white">
                                        <i class="bi bi-toggle-on text-primary"></i>
                                    </span>
                                    <select name="estatus" class="form-select">
                                        <option value="">Todos</option>
                                        <option value="1" selected="@(estatus == "1")">Activo</option>
                                        <option value="0" selected="@(estatus == "0")">Inactivo</option>
                                    </select>
                                </div>
                            </div>

                        <!-- TOP -->
                        <div class="col-12 col-md-4 col-xl-2">
                            <label class="form-label admin-filter-label">Top registros</label>
                            <div class="input-group shadow-sm admin-filter-group">
                                <span class="input-group-text bg-white">
                                    <i class="bi bi-list-ol text-primary"></i>
                                </span>
                                <select name="top" class="form-select">
                                    <option value="10" selected="@(top == "10")">10</option>
                                    <option value="25" selected="@(top == "25")">25</option>
                                    <option value="50" selected="@(top == "50")">50</option>
                                    <option value="100" selected="@(top == "100")">100</option>
                                    <option value="@int.MaxValue" selected="@(top == int.MaxValue.ToString())">Todos</option>
                                    </select>
                            </div>
                        </div>

                        <!-- BOTONES -->
                        <div class="col-12">
                            <div class="admin-filter-actions">
                                <button type="submit" class="btn btn-primary shadow-sm">
                                    <i class="bi bi-search me-2"></i>Buscar
                                </button>

                                <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                                    <i class="bi bi-arrow-clockwise me-2"></i>Limpiar
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

        <!-- TABLA -->
        <div class="card admin-table-card mt-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle admin-table">
                    <thead>
                        <tr>
                            <th class="cup-col-codigo">Código</th>
                            <th class="cup-col-tipo">Tipo</th>
                            <th class="cup-col-descuento">Descuento</th>
                            <th class="cup-col-minimo">Mínimo</th>
                            <th class="cup-col-vigencia">Vigencia</th>
                            <th class="cup-col-uso">Uso</th>
                            <th class="text-center cup-col-estado">Estado</th>
                            <th class="cup-col-acciones">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="cup-col-codigo">
                                        @item.Codigo
                                    </td>

                               
                                    <td class="cup-col-tipo">
                                        @item.TipoDescuento
                                    </td>

                                    <td class="cup-col-descuento">
                                        @item.ValorDescuento
                                    </td>

                                    <td class="cup-col-minimo">
                                        @item.MontoMinimoCompra
                                    </td>

                                    <td class="cup-col-vigencia">
                                        <div class="small">
                                            <div>@item.FechaInicio.ToShortDateString()</div>
                                            <div class="text-muted">hasta</div>
                                            <div>@item.FechaFin.ToShortDateString()</div>
                                        </div>
                                    </td>

                                    <td class="cup-col-uso">
                                        <div class="small">
                                            Max: @item.UsoMaximo <br />
                                            Usuario: @item.UsoPorUsuario
                                        </div>
                                    </td>

                                    <td class="cup-col-estado">
                                        @if (item.Estatus == 1)
                                        {
                                            <span class="admin-status-badge admin-status-active">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="admin-status-badge admin-status-inactive">
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end cat-col-acciones">
                                        <div class="btn-group">
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                                   class="btn admin-action-btn admin-btn-edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <a asp-action="Details" asp-route-id="@item.Id"
                                                   class="btn admin-action-btn admin-btn-view">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8">
                                    <div class="admin-empty-state">
                                        No hay cupones registrados.
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="admin-card-footer">
                Total: <strong>@(Model?.Count() ?? 0)</strong> Cupones
            </div>
        </div>

</div>