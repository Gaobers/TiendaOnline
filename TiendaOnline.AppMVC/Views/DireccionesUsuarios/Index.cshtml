@model IEnumerable<DireccionesUsuario>

@{
    var filtroAlias = Context.Request.Query["alias"].ToString();
    var estatus = Context.Request.Query["estatus"].ToString();


    var hayFiltrosActivos =
        !string.IsNullOrWhiteSpace(filtroAlias) ||
        !string.IsNullOrWhiteSpace(estatus);

}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/pages/direccionesUsuario/index.css" asp-append-version="true" />
}

    <!-- HERO -->
<div class="container admin-index-page dirUsuarios-index">
    <div class="card admin-hero-card">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h1 class="admin-hero-title">
                    <i class="bi bi-geo-alt me-2"></i>Direcciones
                </h1>
                <p class="admin-hero-subtitle">
                    Administra las direcciones registradas por los usuarios en el sistema.
                </p>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-outline-light admin-btn-main"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#filtrosBusqueda"
                        aria-expanded="@(hayFiltrosActivos ? "true" : "false")"
                        aria-controls="filtrosBusqueda">
                    <i class="bi bi-funnel me-1"></i> Filtros
                </button>

                <a asp-action="Create" class="btn btn-light admin-btn-main">
                    <i class="bi bi-plus-lg me-1"></i> Nueva direccion
                </a>
            </div>
        </div>
    </div>

    <!-- FILTRO -->
    <div class="collapse @(hayFiltrosActivos ? "show" : "")" id="filtrosBusqueda">
        <div class="card admin-filter-card mt-3">
            <div class="card-body">
               <form method="get">
                   <div class="row g-3 align-items-end">

                        <!-- TELEFONO -->
                        <div class="col-12 col-md-6 col-xl-3">
                            <label class="form-label admin-filter-label">Alias</label>
                            <div class="input-group shadow-sm admin-filter-group">
                                <span class="input-group-text bg-white">
                                    <i class="bi bi-tag text-primary"></i>
                                </span>
                                <input type="text"
                                        name="alias"
                                        class="form-control"
                                        placeholder="Ej: Casa, Oficina..."
                                        value="@filtroAlias"/>
                            </div>
                        </div>

                        <!-- ESTATUS -->
                        <div class="col-12 col-md-6 col-xl-3">
                            <label class="form-label admin-filter-label">Estado</label>
                            <div class="input-group shadow-sm admin-filter-group">
                                <span class="input-group-text bg-white">
                                    <i class="bi bi-toggle-on text-primary"></i>
                                </span>
                                <select name="estatus" class="form-select">
                                    <option value="">Todos</option>
                                    <option value="1" selected="@(estatus == "1")">Activo</option>
                                    <option value="0" selected="@(estatus == "0")">Inactivo</option>
                                </select>
                            </div>
                        </div>

                        <!-- BOTONES -->
                        <div class="col-12">
                            <div class="admin-filter-actions">
                                <button type="submit" class="btn btn-primary shadow-sm">
                                    <i class="bi bi-search me-2"></i>Buscar
                                </button>

                                <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                                    <i class="bi bi-arrow-clockwise me-2"></i>Limpiar
                                </a>
                            </div>
                        </div>

                   </div>
               </form>
            </div>
        </div>
    </div>

    <!-- TABLA -->
    <div class="card admin-table-card mt-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle admin-table jspaginacion">
                <thead>
                    <tr>
                        <th class="dir-usu-col-direccion">Dirección</th>
                        <th class="dir-usu-col-ubicacion">Ubicación</th>
                        <th class="dir-usu-col-contacto">Contacto</th>
                        <th class="dir-usu-col-principal text-center">Principal</th>
                        <th class="dir-usu-col-estado text-center">Estado</th>
                        <th class="dir-usu-col-acciones text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="dir-usu-col-direccion">
                                    <div class="fw-bold">
                                        @(string.IsNullOrWhiteSpace(item.Alias) ? "Sin alias" : item.Alias)
                                    </div>
                                    <div class="text-muted small">
                                        @(string.IsNullOrWhiteSpace(item.DireccionExacta) ? "Sin dirección" : item.DireccionExacta)
                                    </div>
                                </td>

                                <td class="dir-usu-col-ubicacion">
                                    <div>
                                        @(string.IsNullOrWhiteSpace(item.Departamento) ? "Sin departamento" : item.Departamento)
                                    </div>
                                    <div class="text-muted small">
                                        @(string.IsNullOrWhiteSpace(item.Municipio) ? "Sin municipio" : item.Municipio)
                                    </div>
                                </td>

                                <td class="dir-usu-col-contacto">
                                    @(string.IsNullOrWhiteSpace(item.TelefonoContacto) ? "Sin contacto" : item.TelefonoContacto)
                                </td>

                                <td class="dir-usu-col-principal text-center">
                                    @if (item.EsPrincipal)
                                    {
                                        <span class="admin-status-badge admin-status-active">Sí</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">No</span>
                                    }
                                </td>

                                <td class="dir-usu-col-estado text-center">
                                    @if (item.Estatus == 1)
                                    {
                                        <span class="admin-status-badge admin-status-active">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="admin-status-badge admin-status-inactive">Inactivo</span>
                                    }
                                </td>

                                <td class="dir-usu-col-acciones text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn admin-action-btn admin-btn-edit"
                                               title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a asp-action="Details" asp-route-id="@item.Id"
                                               class="btn admin-action-btn admin-btn-view"
                                               title="Ver detalle">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                No hay direcciones registradas.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="admin-card-footer">
            Total: <strong>@(Model?.Count() ?? 0)</strong> direcciones
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_Paginacion");
    }
}