@model DireccionesUsuario

<div class="admin-create-page">

    <div class="admin-create-hero">
        <div class="admin-create-hero__content">
            <div>
                <div class="admin-create-badge">
                    <i class="bi bi-geo-alt"></i>
                    Gestión de direcciones
                </div>

                <h1 class="admin-create-title">Editar dirección</h1>
                <p class="admin-create-subtitle mb-0">
                    Modifica la información de la dirección seleccionada de forma clara y ordenada.
                </p>
            </div>

            <div class="admin-create-hero__actions">
                <a asp-action="Index" class="btn admin-btn admin-btn-light">
                    <i class="bi bi-arrow-left-short"></i>
                    Volver al listado
                </a>
            </div>
        </div>
    </div>

    <div class="card admin-form-card border-0">
        <div class="card-body p-0">

            <form asp-action="Edit" method="post" class="admin-form">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger admin-validation-box m-0"></div>

                <input type="hidden" asp-for="Id" />

                <div class="admin-section">
                    <div class="admin-section-header">
                        <div class="admin-section-icon">
                            <i class="bi bi-pencil-square"></i>
                        </div>
                        <div>
                            <h5 class="admin-section-title mb-1">Información general</h5>
                            <p class="admin-section-text mb-0">
                                Actualiza los datos principales de la dirección dentro del sistema.
                            </p>
                        </div>
                    </div>

                    <div class="row g-4">

                        <div class="col-md-6">
                            <label asp-for="UsuarioId" class="form-label admin-label"></label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-person"></i>
                                <select asp-for="UsuarioId" class="form-select admin-input" asp-items="ViewBag.UsuarioId">
                                    <option value="">Seleccione un usuario</option>
                                </select>
                            </div>
                            <span asp-validation-for="UsuarioId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Alias" class="form-label admin-label"></label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-bookmark"></i>
                                <input asp-for="Alias" class="form-control admin-input" placeholder="Ej. Casa, Oficina" />
                            </div>
                            <span asp-validation-for="Alias" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Departamento" class="form-label admin-label"></label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-map"></i>
                                <input asp-for="Departamento" class="form-control admin-input" placeholder="Ej. San Salvador" />
                            </div>
                            <span asp-validation-for="Departamento" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Municipio" class="form-label admin-label"></label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-pin-map"></i>
                                <input asp-for="Municipio" class="form-control admin-input" placeholder="Ej. San Salvador" />
                            </div>
                            <span asp-validation-for="Municipio" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="DireccionExacta" class="form-label admin-label"></label>
                            <div class="admin-textarea-wrap">
                                <textarea asp-for="DireccionExacta"
                                          class="form-control admin-input admin-textarea"
                                          rows="4"
                                          placeholder="Escribe la dirección exacta..."></textarea>
                            </div>
                            <span asp-validation-for="DireccionExacta" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Referencia" class="form-label admin-label"></label>
                            <div class="admin-textarea-wrap">
                                <textarea asp-for="Referencia"
                                          class="form-control admin-input admin-textarea"
                                          rows="3"
                                          placeholder="Escribe una referencia para ubicar la dirección..."></textarea>
                            </div>
                            <span asp-validation-for="Referencia" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TelefonoContacto" class="form-label admin-label"></label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-telephone"></i>
                                <input asp-for="TelefonoContacto" class="form-control admin-input" placeholder="Ej. 7000-0000" />
                            </div>
                            <span asp-validation-for="TelefonoContacto" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Estatus" class="form-label admin-label">Estado</label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-check2-circle"></i>
                                <select asp-for="Estatus" class="form-select admin-input">
                                    <option value="1">Activo</option>
                                    <option value="0">Inactivo</option>
                                </select>
                            </div>
                            <span asp-validation-for="Estatus" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label admin-label" asp-for="EsPrincipal"></label>
                            <div class="admin-input-wrap d-flex align-items-center justify-content-between px-3">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-star"></i>
                                    <span class="small text-muted">Marcar esta dirección como principal</span>
                                </div>
                                <div class="form-check form-switch m-0">
                                    <input class="form-check-input" asp-for="EsPrincipal" />
                                </div>
                            </div>
                            <span asp-validation-for="EsPrincipal" class="text-danger small"></span>
                        </div>

                    </div>
                </div>

                <div class="admin-form-actions">
                    <button type="submit" class="btn admin-btn admin-btn-primary">
                        <i class="bi bi-check2-circle"></i>
                        Guardar cambios
                    </button>

                    <a asp-action="Index" class="btn admin-btn admin-btn-outline">
                        <i class="bi bi-x-circle"></i>
                        Cancelar
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}