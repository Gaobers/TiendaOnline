@model MetodosEnvio

<div class="admin-create-page">

    <div class="admin-create-hero">
        <div class="admin-create-hero__content">
            <div>
                <div class="admin-create-badge">
                    <i class="bi bi-truck"></i>
                    Gestión de métodos de envío
                </div>

                <h1 class="admin-create-title">Crear método de envío</h1>
                <p class="admin-create-subtitle mb-0">
                    Configura un nuevo método de envío con su costo y tiempo estimado de entrega.
                </p>
            </div>

            <div class="admin-create-hero__actions">
                <a asp-action="Index" class="btn admin-btn admin-btn-light">
                    <i class="bi bi-arrow-left-short"></i>
                    Volver al listado
                </a>
            </div>
        </div>
    </div>

    <div class="card admin-form-card border-0">
        <div class="card-body p-0">

            <form asp-action="Create" method="post" class="admin-form">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger admin-validation-box m-0"></div>

                <div class="admin-section">
                    <div class="admin-section-header">
                        <div class="admin-section-icon">
                            <i class="bi bi-box-seam"></i>
                        </div>
                        <div>
                            <h5 class="admin-section-title mb-1">Información general</h5>
                            <p class="admin-section-text mb-0">
                                Define el nombre y descripción del método de envío.
                            </p>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="Nombre" class="form-label admin-label"></label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-tag"></i>
                                <input asp-for="Nombre" class="form-control admin-input" placeholder="Ej. Envío estándar" />
                            </div>
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Descripcion" class="form-label admin-label"></label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-card-text"></i>
                                <input asp-for="Descripcion" class="form-control admin-input" placeholder="Ej. Entrega en 3 a 5 días hábiles" />
                            </div>
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="admin-section admin-section--border">
                    <div class="admin-section-header">
                        <div class="admin-section-icon">
                            <i class="bi bi-currency-dollar"></i>
                        </div>
                        <div>
                            <h5 class="admin-section-title mb-1">Costo y tiempo</h5>
                            <p class="admin-section-text mb-0">
                                Especifica el costo del envío y el tiempo estimado de entrega.
                            </p>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="Costo" class="form-label admin-label"></label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-cash-coin"></i>
                                <input asp-for="Costo" class="form-control admin-input" placeholder="Ej. 5.00" />
                            </div>
                            <span asp-validation-for="Costo" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TiempoEstimado" class="form-label admin-label"></label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-clock"></i>
                                <input asp-for="TiempoEstimado" class="form-control admin-input" placeholder="Ej. 2-3 días" />
                            </div>
                            <span asp-validation-for="TiempoEstimado" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="admin-form-actions">
                    <button type="submit" class="btn admin-btn admin-btn-primary">
                        <i class="bi bi-check2-circle"></i>
                        Guardar método
                    </button>

                    <a asp-action="Index" class="btn admin-btn admin-btn-outline">
                        <i class="bi bi-x-circle"></i>
                        Cancelar
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}