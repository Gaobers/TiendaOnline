@model TiendaOnline.AppMVC.Models.PaginaPrincipalViewModel

@{
    ViewData["Title"] = "Inicio - Tienda de Calzado";
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&family=Montserrat:wght@800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<style>
    :root {
        --public-primary: #37b59c;
        --public-primary-dark: #239982;
        --public-dark: #222;
        --public-muted: #777;
        --public-light: #eef3f8;
        --public-border: #e8e8e8;
        --public-title: 'Playfair Display', serif;
        --public-font: 'Inter', sans-serif;
    }

    body {
        background: #fff;
        color: var(--public-dark);
        font-family: var(--public-font);
    }

    .hero-banner {
        background: var(--public-light);
        padding: 90px 20px;
        margin-bottom: 70px;
    }

    .hero-content {
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        align-items: center;
        gap: 40px;
    }

    .hero-text h1 {
        font-family: var(--public-title);
        font-size: 58px;
        color: var(--public-primary);
        margin-bottom: 15px;
    }

    .hero-text p {
        color: var(--public-muted);
        max-width: 480px;
        line-height: 1.8;
    }

    .hero-link {
        display: inline-block;
        margin-top: 10px;
        color: var(--public-primary);
        font-weight: 600;
        text-decoration: none;
    }

    .hero-image {
        text-align: center;
    }

        .hero-image img {
            width: 100%;
            max-width: 560px;
            height: 330px;
            object-fit: contain;
            filter: drop-shadow(0 25px 25px rgba(0,0,0,.18));
        }

    @@media (max-width: 768px) {
        .hero-content {
            grid-template-columns: 1fr;
            text-align: center;
        }

        .hero-text h1 {
            font-size: 42px;
        }

        .hero-text p {
            margin: auto;
        }

        .hero-image img {
            height: 230px;
        }
    }

    .hero-buttons {
        margin-top: 22px;
    }

    .btn-buy-now {
        display: inline-block;
        background: var(--public-primary);
        color: #fff;
        padding: 12px 28px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        border: 1px solid var(--public-primary);
    }

        .btn-buy-now:hover {
            background: var(--public-primary-dark);
            color: #fff;
        }

        .promo-pill i {
            color: var(--public-primary);
            margin-right: 6px;
        }

        .promo-pill:hover {
            background: var(--public-primary);
            color: #fff;
            transform: translateY(-3px);
        }

            .promo-pill:hover i {
                color: #fff;
            }

    .container > h2 {
        font-family: var(--public-title);
        font-size: 34px;
        font-weight: 600 !important;
        color: var(--public-dark) !important;
        margin-bottom: 45px !important;
    }

    .shoe-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
        gap: 45px 30px;
        padding: 0 0 75px;
        max-width: 1120px;
        margin: 0 auto;
    }

    .shoe-card {
        background: transparent;
        border: none;
        box-shadow: none;
        text-align: center;
    }

        .shoe-card:hover {
            transform: translateY(-8px);
            box-shadow: none;
            border: none;
        }

    .img-box {
        height: 190px;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 18px;
        overflow: hidden;
    }

        .img-box img {
            max-width: 90%;
            max-height: 165px;
            object-fit: contain;
            padding: 0;
        }


    .shoe-card:hover img {
        transform: scale(1.08);
    }

    .shoe-body {
        padding: 0 10px;
    }

        .shoe-body h3 {
            font-family: var(--public-title);
            font-size: 16px;
            font-weight: 700;
            color: var(--public-dark);
            margin-bottom: 8px;
        }

    .price-tag {
        font-size: 15px;
        color: var(--public-primary);
        font-weight: 700;
        margin: 8px 0 14px;
    }

    .btn-action {
        display: inline-block;
        width: auto;
        background: transparent;
        color: var(--public-dark);
        border: 1px solid var(--public-primary);
        border-radius: 0;
        padding: 10px 22px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-action:hover {
            background: var(--public-primary);
            color: #fff;
        }

    @@media (max-width: 768px) {
        .hero-banner {
            text-align: center;
            padding: 65px 20px;
        }

            .hero-banner h1 {
                font-size: 40px;
            }

            .hero-banner p {
                margin: 0 auto;
            }

        .promo-container {
            justify-content: center;
        }

        .shoe-grid {
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 35px 20px;
        }
    }
</style>

@{
    var productoHero = Model.ProductosDestacados?.FirstOrDefault();
}

<section class="hero-banner">
    <div class="container hero-content">

        <div class="hero-text">
            <h1>New Arrivals</h1>
            <p>
                Descubre nuestra nueva colección de calzado. Estilo, comodidad y calidad en cada paso.
            </p>

            <a href="#productos" class="hero-link">
                Ver colección <i class="fas fa-arrow-right"></i>
            </a>
            <div class="hero-buttons">
                <a href="#productos" class="btn-buy-now">Comprar ahora</a>
            </div>

        </div>

        <div class="hero-image">
            @if (productoHero != null)
            {
                <img src="@productoHero.ImagenUrl" alt="@productoHero.Nombre" />
            }
        </div>

    </div>
</section>

<div class="container">
    <h2 id="productos" class="text-center mb-5">Productos Destacados</h2>

    <div class="shoe-grid">
        @foreach (var producto in Model.ProductosDestacados)
        {
            <div class="shoe-card">
                <div class="img-box">
                    <img src="@producto.ImagenUrl" alt="@producto.Nombre">
                </div>
                <div class="shoe-body">
                    <h3>@producto.Nombre</h3>
                    <div class="price-tag">$@producto.Precio.ToString("N2")</div>
                    <a asp-controller="Productos" asp-action="DetallePublico" asp-route-id="@producto.Id" class="btn-action"> Ver Detalles </a>
                </div>
            </div>
        }
    </div>
</div>