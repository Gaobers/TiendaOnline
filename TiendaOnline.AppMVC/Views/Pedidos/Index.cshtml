@model IEnumerable<Pedido>

@{
    ViewData["Title"] = "Pedidos";

    var filtroCliente = Context.Request.Query["cliente"].ToString();
    var filtroEstado = Context.Request.Query["estado"].ToString();
    var top = Context.Request.Query["top"].ToString();

    if (string.IsNullOrWhiteSpace(top))
    {
        top = "10";
    }
}

<div class="container-fluid px-lg-5 admin-index-page">

    <!-- HERO -->
    <div class="card admin-hero-card">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h1 class="admin-hero-title">
                    <i class="bi bi-cart-check me-2"></i>Pedidos
                </h1>
                <p class="admin-hero-subtitle">
                    Administra y monitorea las órdenes del sistema.
                </p>
            </div>

            <a asp-action="Create" class="btn btn-light admin-btn-main">
                <i class="bi bi-plus-lg me-1"></i> Nuevo pedido
            </a>
        </div>
    </div>

    <!-- FILTRO -->
    <div class="card admin-filter-card">
        <div class="card-body">
            <form method="get">
                <div class="row g-3 align-items-end">

                    <!-- CLIENTE -->
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label admin-filter-label">Cliente</label>
                        <div class="input-group shadow-sm admin-filter-group">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-person text-primary"></i>
                            </span>
                            <input type="text"
                                   name="cliente"
                                   class="form-control"
                                   placeholder="Nombre del cliente..."
                                   value="@filtroCliente" />
                        </div>
                    </div>

                    <!-- ESTADO -->
                    <div class="col-12 col-md-6 col-xl-3">
                        <label class="form-label admin-filter-label">Estado</label>
                        <div class="input-group shadow-sm admin-filter-group">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-flag text-primary"></i>
                            </span>
                            <input type="text"
                                   name="estado"
                                   class="form-control"
                                   placeholder="Ej: Pendiente..."
                                   value="@filtroEstado" />
                        </div>
                    </div>

                    <!-- TOP -->
                    <div class="col-12 col-md-4 col-xl-2">
                        <label class="form-label admin-filter-label">Top registros</label>
                        <div class="input-group shadow-sm admin-filter-group">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-list-ol text-primary"></i>
                            </span>
                            <select name="top" class="form-select">
                                <option value="10" selected="@(top == "10")">10</option>
                                <option value="25" selected="@(top == "25")">25</option>
                                <option value="50" selected="@(top == "50")">50</option>
                                <option value="100" selected="@(top == "100")">100</option>
                                <option value="@int.MaxValue">Todos</option>
                            </select>
                        </div>
                    </div>

                    <!-- BOTONES -->
                    <div class="col-12">
                        <div class="admin-filter-actions">

                            <button type="submit" class="btn btn-primary shadow-sm">
                                <i class="bi bi-search me-2"></i>Buscar
                            </button>

                            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                                <i class="bi bi-arrow-clockwise me-2"></i>Limpiar
                            </a>

                        </div>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- TABLA -->
    <div class="card admin-table-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Orden</th>
                        <th>Cliente</th>
                        <th>Fecha</th>
                        <th class="text-center">Estado</th>
                        <th>Total</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            var estado = item.EstadoPedido?.Nombre ?? "N/A";

                            <tr>
                                <td>#@item.Id</td>

                                <td class="fw-bold">
                                    ORD-@item.Id.ToString("D3")
                                </td>

                                <td>
                                    <i class="bi bi-person me-1"></i>
                                    @item.NombreCliente
                                </td>

                                <td>
                                    @item.FechaCreacion.ToShortDateString()
                                </td>

                                <td class="text-center">
                                    @if (estado.ToLower().Contains("entregado"))
                                    {
                                        <span class="admin-status-badge admin-status-active">
                                            @estado
                                        </span>
                                    }
                                    else if (estado.ToLower().Contains("pendiente"))
                                    {
                                        <span class="badge bg-warning text-dark">
                                            @estado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @estado
                                        </span>
                                    }
                                </td>

                                <td class="fw-bold">
                                    @item.Total.ToString("C")
                                </td>

                                <td class="text-center">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm border">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm border">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm border">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="admin-empty-state">
                                    No se encontraron pedidos.
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="admin-card-footer">
            Total: <strong>@Model.Count()</strong> pedidos
        </div>
    </div>

</div>