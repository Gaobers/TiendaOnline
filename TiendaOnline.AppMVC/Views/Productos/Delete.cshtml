@model Producto

@{
    ViewData["Title"] = "Delete";
    var activo = Model.Estatus == 1;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h3 class="mb-0">Eliminar producto</h3>
        <div class="text-muted">Confirma la eliminación del registro</div>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        Volver
    </a>
</div>

<div class="card shadow-sm delete-card">
    <div class="card-body p-4">

        <div class="warning-box mb-4">
            ¿Estás seguro de que deseas eliminar este producto?
        </div>

        <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
            <div>
                <h4 class="mb-1">@Model.Nombre</h4>
                <div class="text-muted">SKU: @Model.Sku</div>
            </div>

            @if (activo)
            {
                <span class="prod-badge prod-badge-success">ACTIVO</span>
            }
            else
            {
                <span class="prod-badge prod-badge-danger">INACTIVO</span>
            }
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="prod-text-label">Precio</div>
                <div class="prod-text-value">$@Model.Precio.ToString("0.00")</div>
            </div>

            <div class="col-md-6">
                <div class="prod-text-label">Descripción</div>
                <div class="prod-text-value">@Model.Descripcion</div>
            </div>

            <div class="col-md-6">
                <div class="prod-text-label">Categoría</div>
                <div class="prod-text-value">@(Model.Categoria?.Nombre ?? Model.Categoria?.Id.ToString())</div>
            </div>

            <div class="col-md-6">
                <div class="prod-text-label">Marca</div>
                <div class="prod-text-value">@(Model.Marca?.Nombre ?? Model.Marca?.Id.ToString())</div>
            </div>

            <div class="col-md-6">
                <div class="prod-text-label">Género</div>
                <div class="prod-text-value">@Model.Genero</div>
            </div>

            <div class="col-md-6">
                <div class="prod-text-label">Material</div>
                <div class="prod-text-value">@Model.Material</div>
            </div>

            <div class="col-md-6">
                <div class="prod-text-label">Destacado</div>
                <div class="prod-text-value">@(Model.EsDestacado ? "Sí" : "No")</div>
            </div>

            <div class="col-md-6">
                <div class="prod-text-label">Fecha de creación</div>
                <div class="prod-text-value">@Model.FechaCreacion</div>
            </div>

            <div class="col-md-6">
                <div class="prod-text-label">Última actualización</div>
                <div class="prod-text-value">@Model.FechaActualizacion</div>
            </div>
        </div>

        <form asp-action="Delete" class="mt-4">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Eliminar</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancelar</a>
        </form>
    </div>
</div>