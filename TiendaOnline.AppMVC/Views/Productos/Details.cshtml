@model Producto

@{
    var activo = Model.Estatus == 1;

    var imgUrl = Model.ProductosImagenes?
        .OrderByDescending(i => i.EsPrincipal)
        .ThenByDescending(i => i.FechaCreacion)
        .Select(i => i.Url)
        .FirstOrDefault();
}

<div class="admin-create-page">

    <div class="admin-create-hero">
        <div class="admin-create-hero__content">
            <div>
                <div class="admin-create-badge">
                    <i class="bi bi-box-seam"></i>
                    Gestión de productos
                </div>

                <h1 class="admin-create-title">Detalle de producto</h1>
                <p class="admin-create-subtitle mb-0">
                    Consulta la información completa del producto seleccionado dentro del sistema.
                </p>
            </div>

            <div class="admin-create-hero__actions">
                <a asp-action="Index" class="btn admin-btn admin-btn-light">
                    <i class="bi bi-arrow-left-short"></i>
                    Volver al listado
                </a>
            </div>
        </div>
    </div>

    <div class="card admin-form-card border-0">
        <div class="card-body p-0">

            <div class="admin-form">

                <div class="admin-section">
                    <div class="admin-section-header">
                        <div class="admin-section-icon">
                            <i class="bi bi-image"></i>
                        </div>
                        <div>
                            <h5 class="admin-section-title mb-1">Vista general</h5>
                            <p class="admin-section-text mb-0">
                                Revisa la imagen principal y el estado actual del producto.
                            </p>
                        </div>
                    </div>

                    <div class="row g-4 align-items-center">
                        <div class="col-md-3">
                            @if (!string.IsNullOrWhiteSpace(imgUrl))
                            {
                                <img src="@imgUrl"
                                     alt="Imagen de @Model.Nombre"
                                     class="img-fluid rounded-4 border w-100"
                                     style="max-height: 220px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center rounded-4 border text-muted small w-100"
                                     style="height: 220px;">
                                    Sin imagen
                                </div>
                            }
                        </div>

                        <div class="col-md-9">
                            <div class="row g-4">
                                <div class="col-md-8">
                                    <label class="form-label admin-label">Nombre del producto</label>
                                    <div class="admin-input-wrap">
                                        <i class="bi bi-tag"></i>
                                        <div class="form-control admin-input d-flex align-items-center">
                                            @Model.Nombre
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label admin-label">Estado</label>
                                    <div class="admin-input-wrap">
                                        <i class="bi bi-check2-circle"></i>
                                        <div class="form-control admin-input d-flex align-items-center">
                                            @(activo ? "Activo" : "Inactivo")
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label admin-label">Precio</label>
                                    <div class="admin-input-wrap">
                                        <i class="bi bi-cash-coin"></i>
                                        <div class="form-control admin-input d-flex align-items-center">
                                            $@Model.Precio.ToString("0.00")
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label admin-label">SKU</label>
                                    <div class="admin-input-wrap">
                                        <i class="bi bi-upc-scan"></i>
                                        <div class="form-control admin-input d-flex align-items-center">
                                            @Model.Sku
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <strong>Colores:</strong>
                                    @if (Model.ProductosColores != null && Model.ProductosColores.Any())
                                    {
                                        @string.Join(", ", Model.ProductosColores.Select(pc => pc.Color.Nombre))
                                    }
                                    else
                                    {
                                        <span>No asignados</span>
                                    }
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <div class="admin-section">
                    <div class="admin-section-header">
                        <div class="admin-section-icon">
                            <i class="bi bi-box"></i>
                        </div>
                        <div>
                            <h5 class="admin-section-title mb-1">Información del producto</h5>
                            <p class="admin-section-text mb-0">
                                Revisa los datos generales y atributos principales.
                            </p>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label admin-label">Categoría</label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-grid"></i>
                                <div class="form-control admin-input d-flex align-items-center">
                                    @(Model.Categoria?.Nombre ?? Model.Categoria?.Id.ToString() ?? "Sin categoría")
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label admin-label">Marca</label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-bookmark-star"></i>
                                <div class="form-control admin-input d-flex align-items-center">
                                    @(Model.Marca?.Nombre ?? Model.Marca?.Id.ToString() ?? "Sin marca")
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label admin-label">Género</label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-person-badge"></i>
                                <div class="form-control admin-input d-flex align-items-center">
                                    @(string.IsNullOrWhiteSpace(Model.Genero) ? "Sin definir" : Model.Genero)
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label admin-label">Material</label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-layers"></i>
                                <div class="form-control admin-input d-flex align-items-center">
                                    @(string.IsNullOrWhiteSpace(Model.Material) ? "Sin definir" : Model.Material)
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label admin-label">Destacado</label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-star"></i>
                                <div class="form-control admin-input d-flex align-items-center">
                                    @(Model.EsDestacado ? "Sí" : "No")
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label admin-label">Fecha de creación</label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-calendar-event"></i>
                                <div class="form-control admin-input d-flex align-items-center">
                                    @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label admin-label">Última actualización</label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-clock-history"></i>
                                <div class="form-control admin-input d-flex align-items-center">
                                    @(
                                        @Model.FechaActualizacion?.ToString("dd/MM/yyyy HH:mm") ?? "Sin actualizar"
                                    )
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label admin-label">Descripción</label>
                            <div class="admin-textarea-wrap">
                                <div class="form-control admin-input admin-textarea">
                                    @Model.Descripcion
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="admin-form-actions">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn admin-btn admin-btn-primary">
                        <i class="bi bi-pencil-square"></i>
                        Editar producto
                    </a>

                    <a asp-action="Index" class="btn admin-btn admin-btn-outline">
                        <i class="bi bi-x-circle"></i>
                        Volver
                    </a>
                </div>

            </div>

        </div>
    </div>
</div>