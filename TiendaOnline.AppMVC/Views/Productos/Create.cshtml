@model Producto

@{
    ViewData["Title"] = "Crear producto";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/pages/productos/create.css" asp-append-version="true" />
}

<div class="admin-create-page">

    <div class="card admin-form-card border-0">
        <div class="card-body p-0">

            <form asp-action="Create" method="post" class="admin-form">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger admin-validation-box m-0"></div>

                <div class="admin-section">
                    <div class="admin-section-header">
                        <div class="admin-section-icon">
                            <i class="bi bi-pencil-square"></i>
                        </div>
                        <div>
                            <h5 class="admin-section-title mb-1">Información general</h5>
                            <p class="admin-section-text mb-0">
                                Datos principales para identificar el producto.
                            </p>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="Nombre" class="form-label admin-label"></label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-tag"></i>
                                <input asp-for="Nombre" class="form-control admin-input" placeholder="Ej. Nike Air Max 90" />
                            </div>
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Sku" class="form-label admin-label"></label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-upc-scan"></i>
                                <input asp-for="Sku" class="form-control admin-input" placeholder="Ej. NK-AM90-001" />
                            </div>
                            <span asp-validation-for="Sku" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Precio" class="form-label admin-label"></label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-currency-dollar"></i>
                                <input asp-for="Precio" type="number" step="0.01" class="form-control admin-input" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Precio" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Genero" class="form-label admin-label"></label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-person"></i>
                                <input asp-for="Genero" class="form-control admin-input" placeholder="Ej. Unisex" />
                            </div>
                            <span asp-validation-for="Genero" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Descripcion" class="form-label admin-label"></label>
                            <div class="admin-textarea-wrap">
                                <textarea asp-for="Descripcion" class="form-control admin-input admin-textarea" rows="4" placeholder="Escribe una descripción breve del producto..."></textarea>
                            </div>
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="admin-section admin-section--border">
                    <div class="admin-section-header">
                        <div class="admin-section-icon">
                            <i class="bi bi-diagram-3"></i>
                        </div>
                        <div>
                            <h5 class="admin-section-title mb-1">Clasificación</h5>
                            <p class="admin-section-text mb-0">
                                Relaciona el producto con su categoría, marca y material.
                            </p>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="CategoriaId" class="form-label admin-label"></label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-grid"></i>
                                <select asp-for="CategoriaId" class="form-select admin-input" asp-items="ViewBag.CategoriaId">
                                    <option value="">Seleccione una categoría</option>
                                </select>
                            </div>
                            <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MarcaId" class="form-label admin-label"></label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-bookmark-star"></i>
                                <select asp-for="MarcaId" class="form-select admin-input" asp-items="ViewBag.MarcaId">
                                    <option value="">Seleccione una marca</option>
                                </select>
                            </div>
                            <span asp-validation-for="MarcaId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Material" class="form-label admin-label"></label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-layers"></i>
                                <input asp-for="Material" class="form-control admin-input" placeholder="Ej. Cuero, lona, sintético..." />
                            </div>
                            <span asp-validation-for="Material" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label admin-label d-block">Opciones</label>
                            <div class="admin-check-card">
                                <div class="form-check form-switch m-0">
                                    <input class="form-check-input admin-switch" asp-for="EsDestacado" />
                                    <label class="form-check-label admin-check-label" asp-for="EsDestacado">
                                        Marcar como producto destacado
                                    </label>
                                </div>
                                <small class="text-muted d-block mt-2">
                                    Los productos destacados pueden mostrarse con mayor prioridad dentro del sistema.
                                </small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="admin-form-actions">
                    <button type="submit" class="btn admin-btn admin-btn-primary">
                        <i class="bi bi-check2-circle"></i>
                        Guardar producto
                    </button>

                    <a asp-action="Index" class="btn admin-btn admin-btn-outline">
                        <i class="bi bi-x-circle"></i>
                        Cancelar
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}