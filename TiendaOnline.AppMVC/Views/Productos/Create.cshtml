@model TiendaOnline.AppMVC.Models.Producto

@{
    ViewData["Title"] = "Crear";
}

<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <div>
        <h3 class="mb-0">Crear producto</h3>
        <div class="text-muted">Completa la información del nuevo producto</div>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        Volver
    </a>
</div>

<div class="card shadow-sm create-card">
    <div class="card-body p-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-box mb-4"></div>

            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="Nombre" class="form-label custom-label"></label>
                    <input asp-for="Nombre" class="form-control custom-input" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Sku" class="form-label custom-label"></label>
                    <input asp-for="Sku" class="form-control custom-input" />
                    <span asp-validation-for="Sku" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Precio" class="form-label custom-label"></label>
                    <input asp-for="Precio" class="form-control custom-input" />
                    <span asp-validation-for="Precio" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="FechaActualizacion" class="form-label custom-label"></label>
                    <input asp-for="FechaActualizacion" class="form-control custom-input" />
                    <span asp-validation-for="FechaActualizacion" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Descripcion" class="form-label custom-label"></label>
                    <textarea asp-for="Descripcion" class="form-control custom-input" rows="3"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="CategoriaId" class="form-label custom-label"></label>
                    <select asp-for="CategoriaId" class="form-select custom-input" asp-items="ViewBag.CategoriaId">
                        <option value="">Seleccione una categoría</option>
                    </select>
                    <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="MarcaId" class="form-label custom-label"></label>
                    <select asp-for="MarcaId" class="form-select custom-input" asp-items="ViewBag.MarcaId">
                        <option value="">Seleccione una marca</option>
                    </select>
                    <span asp-validation-for="MarcaId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Genero" class="form-label custom-label"></label>
                    <input asp-for="Genero" class="form-control custom-input" />
                    <span asp-validation-for="Genero" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Material" class="form-label custom-label"></label>
                    <input asp-for="Material" class="form-control custom-input" />
                    <span asp-validation-for="Material" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <div class="form-check featured-check">
                        <input class="form-check-input" asp-for="EsDestacado" />
                        <label class="form-check-label custom-label" asp-for="EsDestacado"></label>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}