@model IEnumerable<TiendaOnline.AppMVC.Models.Producto>

@{
    ViewData["Title"] = "Catálogo de Calzado";
}

<div class="container py-5">
    <!-- Encabezado -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary">Nuestra Colección</h1>
        <p class="text-muted">Explora los mejores modelos registrados en el sistema</p>
    </div>
  
    <!-- Barra de Filtros (Conectada a tu acción Index) --> 
    <form asp-action="Index" method="get" class="row g-3 mb-5 justify-content-center">
        <div class="col-md-5">
            <div class="input-group shadow-sm">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
                <input type="text" name="nombre" class="form-control border-start-0" placeholder="¿Qué buscas hoy?" value="@Context.Request.Query["nombre"]">
            </div>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100 shadow-sm">Buscar</button>
        </div>
    </form>

    <!-- Grid de Productos -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm custom-card">

                    <!-- Contenedor de Imagen -->
                   @*  <div class="position-relative overflow-hidden" style="height: 280px; background-color: #f8f9fa;">
                        @if (item.ProductosImagenes != null && item.ProductosImagenes.Any())
                        {
                            <img src="@item.ProductosImagenes.First().ImagenUrl"
                                 class="card-img-top w-100 h-100"
                                 style="object-fit: cover; transition: transform 0.5s;"
                                 alt="@item.Nombre">
                        }
                        else
                        {
                            <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
                                <i class="bi bi-camera-fill fs-1"></i>
                                <small>Sin Imagen</small>
                            </div>
                        } *@

                        <!-- Badge de Categoría o Marca -->
                        <span class="position-absolute top-0 end-0 m-2 badge bg-dark opacity-75">
                            @(item.Marca?.Nombre ?? "Genérico")
                        </span>
                    </div>

                    <!-- Detalles del Producto -->
                    <div class="card-body d-flex flex-column text-center">
                        <small class="text-primary fw-bold text-uppercase" style="font-size: 0.75rem;">
                            @(item.Categoria?.Nombre ?? "Calzado")
                        </small>
                        <h5 class="card-title mb-2 text-truncate">@item.Nombre</h5>

                        <div class="mt-auto">
                            <p class="h4 fw-bold text-dark mb-3">
                                @item.Precio.ToString("C")
                            </p>

                            <div class="d-grid">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-dark rounded-pill py-2">
                                    Ver Detalle
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            
        }
    </div>
</div>

<!-- Estilos personalizados para que se vea como una tienda real -->
<style>
    .custom-card {
        transition: all 0.3s ease-in-out;
        border-radius: 15px;
    }

    .custom-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
    }

    .custom-card:hover img {
        transform: scale(1.1);
    }

    .card-img-top {
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
    }

    .btn-outline-dark:hover {
        background-color: #212529;
        color: white;
    }
</style>

<!-- Asegúrate de tener Bootstrap Icons para los íconos -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

