@model Producto

<h1>@Model.Nombre</h1>

<p><strong>Precio:</strong> $@Model.Precio</p>
<p>@Model.Descripcion</p>
<p><strong>Marca:</strong> @Model.Marca.Nombre</p>
<p><strong>Categoría:</strong> @Model.Categoria.Nombre</p>

<button class="btn btn-success">Comprar</button> 
public async Task<IActionResult>
DetalleProducto(int? id)
{
if (id == null)
return NotFound();

// Cargamos el producto con sus imágenes, marca, categoría y existencias/tallas
var producto = await _context.Productos
.Include(p => p.Categoria)
.Include(p => p.Marca)
.Include(p => p.Imagenes) // Relación para la galería
.Include(p => p.ProductoTallas) // Relación para el selector de tallas
.ThenInclude(pt => pt.Talla)
.FirstOrDefaultAsync(p => p.Id == id);

if (producto == null)
return NotFound();

return View(producto);
}