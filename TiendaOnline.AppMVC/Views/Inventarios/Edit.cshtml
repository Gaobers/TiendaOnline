@model Inventario

@{
    ViewData["Title"] = "Editar inventario";
}

<div class="admin-create-page">

    <div class="admin-create-hero">
        <div class="admin-create-hero__content">
            <div>
                <div class="admin-create-badge">
                    <i class="bi bi-box-seam"></i>
                    Gestión de inventario
                </div>

                <h1 class="admin-create-title">Editar inventario</h1>
                <p class="admin-create-subtitle mb-0">
                    Actualiza la información del registro de inventario de forma clara y ordenada.
                </p>
            </div>

            <div class="admin-create-hero__actions">
                <a asp-action="Index" class="btn admin-btn admin-btn-light">
                    <i class="bi bi-arrow-left-short"></i>
                    Volver al listado
                </a>
            </div>
        </div>
    </div>

    <div class="card admin-form-card border-0">
        <div class="card-body p-0">

            <form asp-action="Edit" method="post" class="admin-form">
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger admin-validation-box m-0"></div>

                <div class="admin-section">
                    <div class="admin-section-header">
                        <div class="admin-section-icon">
                            <i class="bi bi-pencil-square"></i>
                        </div>
                        <div>
                            <h5 class="admin-section-title mb-1">Información general</h5>
                            <p class="admin-section-text mb-0">
                                Modifica los datos principales del inventario asociado al producto y talla seleccionados.
                            </p>
                        </div>
                    </div>

                    <div class="row g-4">

                        <div class="col-md-6">
                            <label asp-for="ProductoId" class="form-label admin-label"></label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-bag"></i>
                                <select asp-for="ProductoId" class="form-select admin-input" asp-items="ViewBag.ProductoId">
                                    <option value="">Seleccione un producto</option>
                                </select>
                            </div>
                            <span asp-validation-for="ProductoId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TallaId" class="form-label admin-label"></label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-rulers"></i>
                                <select asp-for="TallaId" class="form-select admin-input" asp-items="ViewBag.TallaId">
                                    <option value="">Seleccione una talla</option>
                                </select>
                            </div>
                            <span asp-validation-for="TallaId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Stock" class="form-label admin-label"></label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-boxes"></i>
                                <input asp-for="Stock" type="number" class="form-control admin-input" placeholder="Ej. 15" />
                            </div>
                            <span asp-validation-for="Stock" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StockMinimo" class="form-label admin-label"></label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-exclamation-triangle"></i>
                                <input asp-for="StockMinimo" type="number" class="form-control admin-input" placeholder="Ej. 5" />
                            </div>
                            <span asp-validation-for="StockMinimo" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FechaActualizacion" class="form-label admin-label"></label>
                            <div class="admin-input-wrap">
                                <i class="bi bi-clock-history"></i>
                                <input asp-for="FechaActualizacion" type="datetime-local" class="form-control admin-input" />
                            </div>
                            <span asp-validation-for="FechaActualizacion" class="text-danger small"></span>
                        </div>

                    </div>
                </div>

                <div class="admin-form-actions">
                    <button type="submit" class="btn admin-btn admin-btn-primary">
                        <i class="bi bi-check2-circle"></i>
                        Guardar cambios
                    </button>

                    <a asp-action="Index" class="btn admin-btn admin-btn-outline">
                        <i class="bi bi-x-circle"></i>
                        Cancelar
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}