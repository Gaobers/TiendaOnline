@model IEnumerable<Inventario>

@{
    ViewData["Title"] = "Inventario";

    var filtroProducto = Context.Request.Query["producto"].ToString();
    var filtroTalla = Context.Request.Query["talla"].ToString();
    var top = Context.Request.Query["top"].ToString();

    if (string.IsNullOrWhiteSpace(top))
    {
        top = "10";
    }
}

<div class="container-fluid px-lg-5 admin-index-page">

    <!-- HERO -->
    <div class="card admin-hero-card">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h1 class="admin-hero-title">
                    <i class="bi bi-boxes me-2"></i>Inventario
                </h1>
                <p class="admin-hero-subtitle">
                    Control y gestión del stock de productos.
                </p>
            </div>

            <a asp-action="Create" class="btn btn-light admin-btn-main">
                <i class="bi bi-plus-lg me-1"></i> Nuevo registro
            </a>
        </div>
    </div>

    <!-- FILTRO -->
    <div class="card admin-filter-card">
        <div class="card-body">
            <form method="get">
                <div class="row g-3 align-items-end">

                    <!-- PRODUCTO -->
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label admin-filter-label">Producto</label>
                        <div class="input-group shadow-sm admin-filter-group">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-tag text-primary"></i>
                            </span>
                            <input type="text"
                                   name="producto"
                                   class="form-control"
                                   placeholder="Nombre del producto..."
                                   value="@filtroProducto" />
                        </div>
                    </div>

                    <!-- TALLA -->
                    <div class="col-12 col-md-6 col-xl-3">
                        <label class="form-label admin-filter-label">Talla</label>
                        <div class="input-group shadow-sm admin-filter-group">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-rulers text-primary"></i>
                            </span>
                            <input type="text"
                                   name="talla"
                                   class="form-control"
                                   placeholder="Ej: 42..."
                                   value="@filtroTalla" />
                        </div>
                    </div>

                    <!-- TOP -->
                    <div class="col-12 col-md-4 col-xl-2">
                        <label class="form-label admin-filter-label">Top registros</label>
                        <div class="input-group shadow-sm admin-filter-group">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-list-ol text-primary"></i>
                            </span>
                            <select name="top" class="form-select">
                                <option value="10" selected="@(top == "10")">10</option>
                                <option value="25" selected="@(top == "25")">25</option>
                                <option value="50" selected="@(top == "50")">50</option>
                                <option value="100" selected="@(top == "100")">100</option>
                                <option value="@int.MaxValue">Todos</option>
                            </select>
                        </div>
                    </div>

                    <!-- BOTONES -->
                    <div class="col-12">
                        <div class="admin-filter-actions">

                            <button type="submit" class="btn btn-primary shadow-sm">
                                <i class="bi bi-search me-2"></i>Buscar
                            </button>

                            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                                <i class="bi bi-arrow-clockwise me-2"></i>Limpiar
                            </a>

                        </div>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- TABLA -->
    <div class="card admin-table-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle admin-table">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Talla</th>
                        <th>Stock</th>
                        <th>Stock mínimo</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            var bajoStock = item.Stock <= item.StockMinimo;
                            var agotado = item.Stock == 0;

                            <tr>
                                <!-- PRODUCTO -->
                                <td class="fw-bold">
                                    @(item.Producto?.Nombre ?? "Sin producto")
                                </td>

                                <!-- TALLA -->
                                <td>
                                    @(item.Talla?.Numero ?? item.Talla?.Id.ToString() ?? "Sin talla")
                                </td>

                                <!-- STOCK -->
                                <td>
                                    @item.Stock
                                </td>

                                <!-- STOCK MINIMO -->
                                <td>
                                    @item.StockMinimo
                                </td>

                                <!-- ESTADO -->
                                <td class="text-center">
                                    @if (agotado)
                                    {
                                        <span class="admin-status-badge admin-status-inactive">
                                            Agotado
                                        </span>
                                    }
                                    else if (bajoStock)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Bajo stock
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="admin-status-badge admin-status-active">
                                            Disponible
                                        </span>
                                    }
                                </td>

                                <!-- ACCIONES -->
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm border">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm border">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm border">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                <div class="admin-empty-state">
                                    No hay registros de inventario.
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="admin-card-footer">
            Total: <strong>@(Model?.Count() ?? 0)</strong> registros
        </div>
    </div>

</div>