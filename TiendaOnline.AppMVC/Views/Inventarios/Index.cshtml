@model IEnumerable<Inventario>

@{
    var filtroProducto = Context.Request.Query["producto"].ToString();
    var filtroTalla = Context.Request.Query["talla"].ToString();


    var hayFiltrosActivos =
       !string.IsNullOrWhiteSpace(filtroProducto) ||
       !string.IsNullOrWhiteSpace(filtroTalla);
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/pages/inventarios/index.css" asp-append-version="true" />
}


    <!-- HERO -->
    <div class="container admin-index-page inventario-index">
    <div class="card admin-hero-card">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h1 class="admin-hero-title">
                    <i class="bi bi-boxes me-2"></i>Inventario
                </h1>
                <p class="admin-hero-subtitle">
                    Control y gestión del stock de productos.
                </p>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-outline-light admin-btn-main"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#filtrosBusqueda"
                        aria-expanded="@(hayFiltrosActivos ? "true" : "false")"
                        aria-controls="filtrosBusqueda">
                    <i class="bi bi-funnel me-1"></i> Filtros
                </button>

                <a asp-action="Create" class="btn btn-light admin-btn-main">
                    <i class="bi bi-plus-lg me-1"></i> Nuevo registro
                </a>
            </div>
        </div>
    </div>

    <!-- FILTRO -->
    <div class="collapse @(hayFiltrosActivos ? "show" : "")" id="filtrosBusqueda">
        <div class="card admin-filter-card mt-3">
            <div class="card-body">
                <form method="get">
                    <div class="row g-3 align-items-end">

                        <!-- PRODUCTO -->
                        <div class="col-12 col-md-6 col-xl-4">
                            <label class="form-label admin-filter-label">Producto</label>
                            <div class="input-group shadow-sm admin-filter-group">
                                <span class="input-group-text bg-white">
                                    <i class="bi bi-tag text-primary"></i>
                                </span>
                                <input type="text"
                                       name="producto"
                                       class="form-control"
                                       placeholder="Nombre del producto..."
                                       value="@filtroProducto" />
                            </div>
                        </div>

                        <!-- TALLA -->
                        <div class="col-12 col-md-6 col-xl-3">
                            <label class="form-label admin-filter-label">Talla</label>
                            <div class="input-group shadow-sm admin-filter-group">
                                <span class="input-group-text bg-white">
                                    <i class="bi bi-rulers text-primary"></i>
                                </span>
                                <input type="text"
                                       name="talla"
                                       class="form-control"
                                       placeholder="Ej: 42..."
                                       value="@filtroTalla" />
                            </div>
                        </div>

                        <!-- BOTONES -->
                        <div class="col-12">
                            <div class="admin-filter-actions">

                                <button type="submit" class="btn btn-primary shadow-sm">
                                    <i class="bi bi-search me-2"></i>Buscar
                                </button>

                                <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                                    <i class="bi bi-arrow-clockwise me-2"></i>Limpiar
                                </a>

                            </div>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- TABLA -->
    <div class="card admin-table-card mt-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle admin-table jspaginacion">
                <thead>
                    <tr>
                        <th class="inv-col-producto">Producto</th>
                        <th class="inv-col-talla">Talla</th>
                        <th class="inv-col-stock">Stock</th>
                        <th class="inv-col-stockminimo">Stock mínimo</th>
                        <th class="inv-col-acciones">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <!-- PRODUCTO -->
                                <td class="inv-col-producto">
                                    @item.Producto?.Nombre
                                </td>

                                <!-- TALLA -->
                                <td class="inv-col-talla">
                                    @item.Talla?.Numero
                                </td>

                                <!-- STOCK -->
                                <td class="inv-col-stock">
                                    @item.Stock
                                </td>

                                <!-- STOCK MINIMO -->
                                <td class="inv-col-stockminimo">
                                    @item.StockMinimo
                                </td>

                                <!-- ACCIONES -->
                                <td class="inv-col-acciones">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn admin-action-btn admin-btn-edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a asp-action="Details" asp-route-id="@item.Id"
                                               class="btn admin-action-btn admin-btn-view">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                   
                </tbody>
            </table>
        </div>

        <div class="admin-card-footer">
            Total: <strong>@(Model?.Count() ?? 0)</strong> registros
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_Paginacion");
    }
}