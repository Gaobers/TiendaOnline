@model IEnumerable<TiendaOnline.AppMVC.Models.Inventario>

@{
    ViewData["Title"] = "Inventario";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h3 class="mb-0">Inventario</h3>
        <div class="text-muted">Listado general</div>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        + Nuevo registro
    </a>
</div>

<div class="card shadow-sm products-card">
    <div class="card-body p-0">

        <!-- Encabezado desktop -->
        <div class="d-none d-md-flex products-header px-3 py-3">
            <div class="col-md-3">Producto</div>
            <div class="col-md-2">Talla</div>
            <div class="col-md-2">Stock</div>
            <div class="col-md-2">Stock mínimo</div>
            <div class="col-md-1">Estado</div>
            <div class="col-md-2 text-end">Acciones</div>
        </div>

        <!-- Filas -->
        @foreach (var item in Model)
        {
            var bajoStock = item.Stock <= item.StockMinimo;
            var agotado = item.Stock == 0;

            <div class="product-row d-flex align-items-center px-3 py-3 border-bottom flex-wrap">

                <!-- Producto -->
                <div class="col-12 col-md-3 mb-2 mb-md-0">
                    <div class="name fw-semibold">
                        @(item.Producto?.Nombre ?? "Sin producto")
                    </div>
                </div>

                <!-- Talla -->
                <div class="col-6 col-md-2 mb-2 mb-md-0">
                    <div class="text-muted small d-md-none">Talla</div>
                    <div>
                        @(item.Talla?.Numero ?? item.Talla?.Id.ToString() ?? "Sin talla")
                    </div>
                </div>

                <!-- Stock -->
                <div class="col-6 col-md-2 mb-2 mb-md-0">
                    <div class="text-muted small d-md-none">Stock</div>
                    <div class="qty fw-semibold">@item.Stock</div>
                </div>

                <!-- Stock mínimo -->
                <div class="col-6 col-md-2 mt-2 mt-md-0">
                    <div class="text-muted small d-md-none">Stock mínimo</div>
                    <div>@item.StockMinimo</div>
                </div>

                <!-- Estado -->
                <div class="col-6 col-md-1 mt-2 mt-md-0">
                    <div class="text-muted small d-md-none">Estado</div>
                    @if (agotado)
                    {
                        <span class="badge-soft badge-soft-danger">AGOTADO</span>
                    }
                    else if (bajoStock)
                    {
                        <span class="badge-soft badge-soft-warning">BAJO</span>
                    }
                    else
                    {
                        <span class="badge-soft badge-soft-success">OK</span>
                    }
                </div>

                <!-- Acciones -->
                <div class="col-12 col-md-2 mt-3 mt-md-0 d-flex justify-content-md-end gap-2">
                    <a class="action-btn" asp-action="Edit" asp-route-id="@item.Id" title="Editar">✏️</a>
                    <a class="action-btn" asp-action="Details" asp-route-id="@item.Id" title="Detalles">🔎</a>
                    <a class="action-btn" asp-action="Delete" asp-route-id="@item.Id" title="Eliminar">🗑️</a>
                </div>
            </div>
        }
    </div>
</div>