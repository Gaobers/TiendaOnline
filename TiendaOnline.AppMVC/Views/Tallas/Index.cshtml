@model IEnumerable<Talla>

@{
    var filtroNumero = Context.Request.Query["numero"].ToString();
    var filtroestatus = Context.Request.Query["estatus"].ToString();
    byte? estatus = ViewBag.Estatus != null ? (byte)ViewBag.Estatus : null;

    var hayFiltrosActivos =
    !string.IsNullOrWhiteSpace(filtroNumero) ||
    !string.IsNullOrWhiteSpace(filtroestatus);
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/pages/tallas/index.css" asp-append-version="true" />
}


    <!-- HERO -->
<div class="container admin-index-page tallas-index">
    <div class="card admin-hero-card">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h1 class="admin-hero-title">
                    <i class="bi bi-aspect-ratio me-2"></i>Tallas
                </h1>
                <p class="admin-hero-subtitle">
                    Administra las tallas disponibles en el sistema.
                </p>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-outline-light admin-btn-main"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#filtrosBusqueda"
                        aria-expanded="@(hayFiltrosActivos ? "true" : "false")"
                        aria-controls="filtrosBusqueda">
                    <i class="bi bi-funnel me-1"></i> Filtros
                </button>

                <a asp-action="Create" class="btn btn-light admin-btn-main">
                    <i class="bi bi-plus-lg me-1"></i> Nueva talla
                </a>
           </div>
        </div>
    </div>

    <!-- FILTRO -->
    <div class="collapse @(hayFiltrosActivos ? "show" : "")" id="filtrosBusqueda">
        <div class="card admin-filter-card mt-3">
            <div class="card-body">
            <form method="get">
                <div class="row g-3 align-items-end">

                    <!-- NUMERO -->
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label admin-filter-label">Número</label>
                        <div class="input-group shadow-sm admin-filter-group">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-123 text-primary"></i>
                            </span>
                            <input type="text"
                                   name="numero"
                                   class="form-control"
                                   placeholder="Ej: 38, 40, 42..."
                                   value="@filtroNumero" />
                        </div>
                    </div>

                        <!-- ESTATUS -->
                        <div class="col-12 col-md-6 col-xl-3">
                            <label class="form-label admin-filter-label">Estado</label>
                            <div class="input-group shadow-sm admin-filter-group">
                                <span class="input-group-text bg-white">
                                    <i class="bi bi-toggle-on text-primary"></i>
                                </span>
                                <select name="estatus" class="form-select">
                                    <option value="">Todos</option>
                                    <option value="1" selected="@(estatus == 1 ? "selected" : null)">Activo</option>
                                    <option value="0" selected="@(estatus == 0 ? "selected" : null)">Inactivo</option>
                                </select>
                            </div>
                        </div>

                    <!-- BOTONES -->
                        <div class="col-12">
                            <div class="admin-filter-actions">
                                <button type="submit" class="btn btn-primary shadow-sm">
                                    <i class="bi bi-search me-2"></i>Buscar
                                </button>

                                <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                                    <i class="bi bi-arrow-clockwise me-2"></i>Limpiar
                                </a>
                            </div>
                        </div>

                </div>
            </form>
           </div>
        </div>
    </div>

    <!-- TABLA -->
    <div class="card admin-table-card mt-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle admin-table jspaginacion">
                <thead>
                    <tr>
                        <th class="tal-col-numero">Número</th>
                        <th class="tal-col-estado text-center">Estado</th>
                        <th class="tal-col-creacion">Creación</th>
                        <th class="tal-col-acciones">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <!-- NUMERO -->
                                <td class="tal-col-numero">
                                    @item.Numero
                                </td>

                                <!-- ESTADO -->
                                <td class="tal-col-estado text-center">
                                    @if (item.Estatus == 1)
                                    {
                                        <span class="admin-status-badge admin-status-active">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="admin-status-badge admin-status-inactive">
                                            Inactivo
                                        </span>
                                    }
                                </td>

                                <!-- FECHA -->
                                <td class="tal-col-creacion">
                                    @item.FechaCreacion.ToShortDateString()
                                </td>

                                <!-- ACCIONES -->
                                <td class="tal-col-acciones">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn admin-action-btn admin-btn-edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a asp-action="Details" asp-route-id="@item.Id"
                                               class="btn admin-action-btn admin-btn-view">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                   
                </tbody>
            </table>
        </div>

        <div class="admin-card-footer">
            Total: <strong>@(Model?.Count() ?? 0)</strong> tallas
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_Paginacion");
    }
}