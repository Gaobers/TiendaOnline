@model IEnumerable<Talla>

@{
    ViewData["Title"] = "Tallas";

    var filtroNumero = Context.Request.Query["numero"].ToString();
    var filtroestatus = Context.Request.Query["estatus"].ToString();
    var filtrotop = Context.Request.Query["top"].ToString();

    if (string.IsNullOrWhiteSpace(filtrotop))
    {
        filtrotop = "10";
    }

    var hayFiltrosActivos =
    !string.IsNullOrWhiteSpace(filtroNumero) ||
    !string.IsNullOrWhiteSpace(filtroestatus) ||
    !string.IsNullOrWhiteSpace(filtrotop) ||
    filtrotop != "10";
}

<div class="container admin-index-page">

    <!-- HERO -->
    <div class="card admin-hero-card">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h1 class="admin-hero-title">
                    <i class="bi bi-aspect-ratio me-2"></i>Tallas
                </h1>
                <p class="admin-hero-subtitle">
                    Administra las tallas disponibles en el sistema.
                </p>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-outline-light admin-btn-main"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#filtrosBusqueda"
                        aria-expanded="@(hayFiltrosActivos ? "true" : "false")"
                        aria-controls="filtrosBusqueda">
                    <i class="bi bi-funnel me-1"></i> Filtros
                </button>

                <a asp-action="Create" class="btn btn-light admin-btn-main">
                    <i class="bi bi-plus-lg me-1"></i> Nueva talla
                </a>
           </div>
        </div>
    </div>

    <!-- FILTRO -->
    <div class="collapse @(hayFiltrosActivos ? "show" : "")" id="filtrosBusqueda">
        <div class="card admin-filter-card mt-3">
            <div class="card-body">
            <form method="get">
                <div class="row g-3 align-items-end">

                    <!-- NUMERO -->
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label admin-filter-label">Número</label>
                        <div class="input-group shadow-sm admin-filter-group">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-123 text-primary"></i>
                            </span>
                            <input type="text"
                                   name="numero"
                                   class="form-control"
                                   placeholder="Ej: 38, 40, 42..."
                                   value="@filtroNumero" />
                        </div>
                    </div>

                    <!-- ESTATUS -->
                    <div class="col-12 col-md-4 col-xl-2">
                        <label class="form-label admin-filter-label">Estado</label>
                        <div class="input-group shadow-sm admin-filter-group">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-toggle-on text-primary"></i>
                            </span>
                            <select name="estatus" class="form-select">
                                <option value="">Todos</option>
                                <option value="1" selected="@(filtroestatus == "1")">Activo</option>
                                <option value="0" selected="@(filtroestatus == "0")">Inactivo</option>
                            </select>
                        </div>
                    </div>

                    <!-- TOP -->
                    <div class="col-12 col-md-4 col-xl-2">
                        <label class="form-label admin-filter-label">Top registros</label>
                        <div class="input-group shadow-sm admin-filter-group">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-list-ol text-primary"></i>
                            </span>
                            <select name="top" class="form-select">
                                <option value="10" selected="@(filtrotop == "10")">10</option>
                                <option value="25" selected="@(filtrotop == "25")">25</option>
                                <option value="50" selected="@(filtrotop == "50")">50</option>
                                <option value="100" selected="@(filtrotop == "100")">100</option>
                                <option value="@int.MaxValue">Todos</option>
                            </select>
                        </div>
                    </div>

                    <!-- BOTONES -->
                    <div class="col-12">
                        <div class="admin-filter-actions">

                            <button type="submit" class="btn btn-primary shadow-sm">
                                <i class="bi bi-search me-2"></i>Buscar
                            </button>

                            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                                <i class="bi bi-arrow-clockwise me-2"></i>Limpiar
                            </a>

                        </div>
                    </div>

                </div>
            </form>
           </div>
        </div>
    </div>

    <!-- TABLA -->
    <div class="card admin-table-card mt-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle admin-table">
                <thead>
                    <tr>
                        <th>Número</th>
                        <th class="text-center">Estado</th>
                        <th>Creación</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <!-- NUMERO -->
                                <td class="fw-bold">
                                    @item.Numero
                                </td>

                                <!-- ESTADO -->
                                <td class="text-center">
                                    @if (item.Estatus == 1)
                                    {
                                        <span class="admin-status-badge admin-status-active">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="admin-status-badge admin-status-inactive">
                                            Inactivo
                                        </span>
                                    }
                                </td>

                                <!-- FECHA -->
                                <td>
                                    @item.FechaCreacion.ToShortDateString()
                                </td>

                                <!-- ACCIONES -->
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm border">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm border">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm border">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4">
                                <div class="admin-empty-state">
                                    No hay tallas registradas.
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="admin-card-footer">
            Total: <strong>@(Model?.Count() ?? 0)</strong> tallas
        </div>
    </div>

</div>