@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Security.Claims
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
    var userName = User?.Identity?.Name ?? "Usuario";
    var userRole = User?.FindFirst(ClaimTypes.Role)?.Value ?? "";
    var firstLetter = !string.IsNullOrWhiteSpace(userName) ? userName.Substring(0, 1).ToUpper() : "U";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TiendaOnline Admin</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/TiendaOnline.AppMVC.styles.css" asp-append-version="true" />

    <!-- CSS existente -->
    <link rel="stylesheet" href="~/css/admin/base/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/components/page.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/components/cards.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/components/filters.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/components/tables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/components/utilities.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/components/buttons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/components/badges.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/components/forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/components/sections.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/components/validation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/components/auth-menu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/components/pagination.css" asp-append-version="true" />

    <!-- Nuevo CSS principal admin -->
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    @RenderSection("Styles", required: false)
</head>
<body class="admin-body">

    <div class="admin-shell">

        <!-- SIDEBAR -->
        <aside class="admin-sidebar" id="adminSidebar">

            <div class="admin-sidebar-top">
                <a asp-controller="Home" asp-action="Index" class="admin-brand text-decoration-none">
                    <span class="admin-brand-icon">
                        <i class="bi bi-bag-heart-fill"></i>
                    </span>
                    <div class="admin-brand-text">
                        <strong>TiendaOnline</strong>
                        <small>Admin Panel</small>
                    </div>
                </a>

                <button class="admin-sidebar-toggle d-none d-lg-inline-flex" type="button" id="sidebarCollapseBtn" title="Contraer menú">
                    <i class="bi bi-list"></i>
                </button>
            </div>

            <div class="admin-sidebar-scroll">

                <!-- DASHBOARD -->
                <div class="admin-menu-group static-group">
                    <div class="admin-menu-label">General</div>

                    <a asp-controller="Home" asp-action="Index"
                           class="admin-menu-link @(currentController == "Home" ? "active" : "")">
                        <i class="bi bi-grid-1x2"></i>
                        <span>Dashboard</span>
                    </a>
                </div>

                <!-- CATALOGO -->
                <div class="admin-menu-group">
                    <button class="admin-group-toggle @(currentController == "Productos" || currentController == "Categorias" || currentController == "Marcas" || currentController == "Colores" || currentController == "Tallas" || currentController == "Inventarios" ? "expanded" : "")"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#menuCatalogo"
                            aria-expanded="@(currentController == "Productos" || currentController == "Categorias" || currentController == "Marcas" || currentController == "Colores" || currentController == "Tallas" || currentController == "Inventarios" ? "true" : "false")">
                        <span class="admin-group-title">
                            <i class="bi bi-box-seam"></i>
                            <span>Catálogo</span>
                        </span>
                        <i class="bi bi-chevron-down admin-group-arrow"></i>
                    </button>

                    <div id="menuCatalogo" class="collapse @(currentController == "Productos" || currentController == "Categorias" || currentController == "Marcas" || currentController == "Colores" || currentController == "Tallas" || currentController == "Inventarios" ? "show" : "")">
                        <div class="admin-submenu">
                            <a asp-controller="Productos" asp-action="Index" class="admin-submenu-link @(currentController == "Productos" ? "active" : "")">
                                <i class="bi bi-dot"></i><span>Productos</span>
                            </a>
                            <a asp-controller="Categorias" asp-action="Index" class="admin-submenu-link @(currentController == "Categorias" ? "active" : "")">
                                <i class="bi bi-dot"></i><span>Categorías</span>
                            </a>
                            <a asp-controller="Marcas" asp-action="Index" class="admin-submenu-link @(currentController == "Marcas" ? "active" : "")">
                                <i class="bi bi-dot"></i><span>Marcas</span>
                            </a>
                            <a asp-controller="Colores" asp-action="Index" class="admin-submenu-link @(currentController == "Colores" ? "active" : "")">
                                <i class="bi bi-dot"></i><span>Colores</span>
                            </a>
                            <a asp-controller="Tallas" asp-action="Index" class="admin-submenu-link @(currentController == "Tallas" ? "active" : "")">
                                <i class="bi bi-dot"></i><span>Tallas</span>
                            </a>
                            <a asp-controller="Inventarios" asp-action="Index" class="admin-submenu-link @(currentController == "Inventarios" ? "active" : "")">
                                <i class="bi bi-dot"></i><span>Inventario</span>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- VENTAS -->
                <div class="admin-menu-group">
                    <button class="admin-group-toggle @(currentController == "Pedidos" || currentController == "EstadosPedidos" || currentController == "MetodosPagos" || currentController == "MetodosEnvios" || currentController == "Cupones" ? "expanded" : "")"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#menuVentas"
                            aria-expanded="@(currentController == "Pedidos" || currentController == "EstadosPedidos" || currentController == "MetodosPagos" || currentController == "MetodosEnvios" || currentController == "Cupones" ? "true" : "false")">
                        <span class="admin-group-title">
                            <i class="bi bi-cart3"></i>
                            <span>Ventas</span>
                        </span>
                        <i class="bi bi-chevron-down admin-group-arrow"></i>
                    </button>

                    <div id="menuVentas" class="collapse @(currentController == "Pedidos" || currentController == "EstadosPedidos" || currentController == "MetodosPagos" || currentController == "MetodosEnvios" || currentController == "Cupones" ? "show" : "")">
                        <div class="admin-submenu">
                            <a asp-controller="Pedidos" asp-action="Index" class="admin-submenu-link @(currentController == "Pedidos" ? "active" : "")">
                                <i class="bi bi-dot"></i><span>Pedidos</span>
                            </a>
                            <a asp-controller="EstadosPedidos" asp-action="Index" class="admin-submenu-link @(currentController == "EstadosPedidos" ? "active" : "")">
                                <i class="bi bi-dot"></i><span>Estados de pedido</span>
                            </a>
                            <a asp-controller="MetodosPagos" asp-action="Index" class="admin-submenu-link @(currentController == "MetodosPagos" ? "active" : "")">
                                <i class="bi bi-dot"></i><span>Métodos de pago</span>
                            </a>
                            <a asp-controller="MetodosEnvios" asp-action="Index" class="admin-submenu-link @(currentController == "MetodosEnvios" ? "active" : "")">
                                <i class="bi bi-dot"></i><span>Métodos de envío</span>
                            </a>
                            <a asp-controller="Cupones" asp-action="Index" class="admin-submenu-link @(currentController == "Cupones" ? "active" : "")">
                                <i class="bi bi-dot"></i><span>Cupones</span>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- USUARIOS -->
                @if (isAuthenticated)
                {
                    <div class="admin-menu-group">
                        <button class="admin-group-toggle @(currentController == "Usuarios" || currentController == "Roles" || currentController == "DireccionesUsuarios" ? "expanded" : "")"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#menuUsuarios"
                                aria-expanded="@(currentController == "Usuarios" || currentController == "Roles" || currentController == "DireccionesUsuarios" ? "true" : "false")">
                            <span class="admin-group-title">
                                <i class="bi bi-people"></i>
                                <span>Usuarios</span>
                            </span>
                            <i class="bi bi-chevron-down admin-group-arrow"></i>
                        </button>

                        <div id="menuUsuarios" class="collapse @(currentController == "Usuarios" || currentController == "Roles" || currentController == "DireccionesUsuarios" ? "show" : "")">
                            <div class="admin-submenu">
                                <a asp-controller="Usuarios" asp-action="Index" class="admin-submenu-link @(currentController == "Usuarios" && currentAction == "Index" ? "active" : "")">
                                    <i class="bi bi-dot"></i><span>Usuarios</span>
                                </a>

                                <a asp-controller="Usuarios" asp-action="ChangePassword" class="admin-submenu-link @(currentController == "Usuarios" && currentAction == "ChangePassword" ? "active" : "")">
                                    <i class="bi bi-dot"></i><span>Cambiar contraseña</span>
                                </a>

                                <a asp-controller="Roles" asp-action="Index" class="admin-submenu-link @(currentController == "Roles" ? "active" : "")">
                                    <i class="bi bi-dot"></i><span>Roles</span>
                                </a>

                                <a asp-controller="DireccionesUsuarios" asp-action="Index" class="admin-submenu-link @(currentController == "DireccionesUsuarios" ? "active" : "")">
                                    <i class="bi bi-dot"></i><span>Direcciones</span>
                                </a>
                            </div>
                        </div>
                    </div>
                }

            </div>

        </aside>

        <!-- CONTENT AREA -->
        <div class="admin-main">

            <!-- TOPBAR -->
            <header class="admin-topbar">
                <div class="admin-topbar-left">
                    <button class="admin-mobile-toggle d-inline-flex d-lg-none" type="button" id="mobileSidebarBtn">
                        <i class="bi bi-list"></i>
                    </button>

                    <div class="admin-topbar-search">
                        <i class="bi bi-search"></i>
                        <input type="text" class="form-control" placeholder="Buscar..." />
                    </div>
                </div>

                <div class="admin-topbar-right">
                    @if (isAuthenticated)
                    {
                        <div class="dropdown admin-user-dropdown">
                            <button class="dropdown-toggle admin-user-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="admin-user-avatar">@firstLetter</div>

                                <div class="admin-user-meta">
                                    <span class="admin-user-name">Bienvenido, @userName</span>
                                    <span class="admin-user-role">@userRole</span>
                                </div>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end">
                                <li class="dropdown-header">
                                    <div class="fw-bold text-dark">@userName</div>
                                    <small class="text-muted">@userRole</small>
                                </li>

                                <li>
                                    <a class="dropdown-item" asp-controller="Usuarios" asp-action="Index">
                                        <i class="bi bi-people"></i>
                                        <span>Ir a usuarios</span>
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" asp-controller="Usuarios" asp-action="ChangePassword">
                                        <i class="bi bi-key"></i>
                                        <span>Cambiar contraseña</span>
                                    </a>
                                </li>

                                <li><hr class="dropdown-divider" /></li>

                                <li>
                                    <a class="dropdown-item text-danger" asp-controller="Usuarios" asp-action="Logout">
                                        <i class="bi bi-box-arrow-right"></i>
                                        <span>Cerrar sesión</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Usuarios" asp-action="Login" class="admin-auth-link">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Iniciar sesión</span>
                        </a>
                    }
                </div>
            </header>

            <!-- PAGE -->
            <main class="admin-content">
                <div class="admin-page-head">
                    <div>
                        <h1 class="admin-page-title">@ViewData["Title"]</h1>
                    </div>
                </div>

                @RenderBody()
            </main>

        </div>
    </div>

    <div class="admin-sidebar-backdrop" id="adminSidebarBackdrop"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
            document.addEventListener("DOMContentLoaded", function () {
                const body = document.body;
                const sidebar = document.getElementById("adminSidebar");
                const collapseBtn = document.getElementById("sidebarCollapseBtn");
                const mobileBtn = document.getElementById("mobileSidebarBtn");
                const backdrop = document.getElementById("adminSidebarBackdrop");

                if (collapseBtn) {
                    collapseBtn.addEventListener("click", function () {
                        body.classList.toggle("admin-sidebar-collapsed");
                    });
                }

                if (mobileBtn) {
                    mobileBtn.addEventListener("click", function () {
                        body.classList.add("admin-sidebar-mobile-open");
                    });
                }

                if (backdrop) {
                    backdrop.addEventListener("click", function () {
                        body.classList.remove("admin-sidebar-mobile-open");
                    });
                }

                const groupButtons = document.querySelectorAll(".admin-group-toggle");
                groupButtons.forEach(btn => {
                    const targetSelector = btn.getAttribute("data-bs-target");
                    const target = document.querySelector(targetSelector);

                    if (target) {
                        target.addEventListener("show.bs.collapse", function () {
                            btn.classList.add("expanded");
                        });

                        target.addEventListener("hide.bs.collapse", function () {
                            btn.classList.remove("expanded");
                        });
                    }
                });
            });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>