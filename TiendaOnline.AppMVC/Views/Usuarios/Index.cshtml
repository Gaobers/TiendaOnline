@model IEnumerable<Usuario>

@{
    ViewData["Title"] = "Gestión de Usuarios";

    var filtroNombre = Context.Request.Query["nombre"].ToString();
    var filtroCorreo = Context.Request.Query["correo"].ToString();
    var top = Context.Request.Query["top"].ToString();

    if (string.IsNullOrWhiteSpace(top))
    {
        top = "10";
    }
}

<div class="container-fluid px-lg-5 admin-index-page">

    <!-- HERO -->
    <div class="card admin-hero-card">
        <div class="card-body d-flex flex-column flex-lg-row justify-content-between align-items-lg-center">
            <div>
                <h1 class="admin-hero-title">
                    <i class="bi bi-people-fill me-2"></i>Usuarios
                </h1>
                <p class="admin-hero-subtitle">
                    Administra los registros de usuarios del sistema.
                </p>
            </div>

            <div class="mt-3 mt-lg-0">
                <a asp-action="Create" class="btn btn-light admin-btn-main">
                    <i class="bi bi-plus-lg me-1"></i> Nuevo Registro
                </a>
            </div>
        </div>
    </div>

    <!-- FILTRO (TOMADO DE CATEGORIAS, ADAPTADO) -->
    <div class="card admin-filter-card">
        <div class="card-body">
            <form method="get">
                <div class="row g-3 align-items-end">

                    <!-- NOMBRE -->
                    <div class="col-12 col-md-6 col-xl-3">
                        <label class="form-label admin-filter-label">Nombre</label>
                        <div class="input-group shadow-sm admin-filter-group">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-person text-primary"></i>
                            </span>
                            <input type="text"
                                   name="nombre"
                                   class="form-control"
                                   placeholder="Ej: Carlos..."
                                   value="@filtroNombre" />
                        </div>
                    </div>

                    <!-- CORREO -->
                    <div class="col-12 col-md-6 col-xl-5">
                        <label class="form-label admin-filter-label">Correo</label>
                        <div class="input-group shadow-sm admin-filter-group">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-envelope text-primary"></i>
                            </span>
                            <input type="text"
                                   name="correo"
                                   class="form-control"
                                   placeholder="Buscar por correo..."
                                   value="@filtroCorreo" />
                        </div>
                    </div>

                    <!-- TOP -->
                    <div class="col-12 col-md-4 col-xl-2">
                        <label class="form-label admin-filter-label">Top registros</label>
                        <div class="input-group shadow-sm admin-filter-group">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-list-ol text-primary"></i>
                            </span>
                            <select name="top" class="form-select">
                                <option value="10" selected="@(top == "10")">10</option>
                                <option value="25" selected="@(top == "25")">25</option>
                                <option value="50" selected="@(top == "50")">50</option>
                                <option value="100" selected="@(top == "100")">100</option>
                                <option value="500" selected="@(top == "500")">500</option>
                                <option value="1000" selected="@(top == "1000")">1000</option>
                                <option value="@int.MaxValue" selected="@(top == int.MaxValue.ToString())">Todos</option>
                            </select>
                        </div>
                    </div>

                    <!-- BOTONES -->
                    <div class="col-12">
                        <div class="admin-filter-actions">

                            <button type="submit" class="btn btn-primary shadow-sm">
                                <i class="bi bi-search me-2"></i>Buscar
                            </button>

                            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                                <i class="bi bi-arrow-clockwise me-2"></i>Limpiar
                            </a>

                        </div>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- TABLA (SE MANTIENE EXACTAMENTE TU ESTILO DE USUARIOS) -->
    <div class="card admin-table-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle admin-table">
                    <thead>
                        <tr>
                            <th class="ps-4 py-3">Nombre</th>
                            <th>Correo</th>
                            <th>Clave</th>
                            <th>Rol</th>
                            <th class="text-center">Estado</th>
                            <th>Registro</th>
                            <th class="text-center pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="admin-avatar-circle">
                                                <i class="bi bi-person-circle fs-5"></i>
                                            </div>
                                            <span class="admin-user-name">@item.Nombre</span>
                                        </div>
                                    </td>

                                    <td>
                                        <a href="mailto:@item.Correo" class="admin-mail-link">
                                            @item.Correo
                                        </a>
                                    </td>

                                    <td>
                                        <span class="badge bg-light text-dark border admin-code-badge">
                                            @item.PasswordHash
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge bg-secondary-subtle text-secondary border admin-role-badge">
                                            @(item.Rol?.Nombre ?? "")
                                        </span>
                                    </td>

                                    <td class="text-center">
                                        @if (item.Estatus.ToString().ToLower() == "true" || item.Estatus.ToString() == "1")
                                        {
                                            <span class="admin-status-badge admin-status-active">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="admin-status-badge admin-status-inactive">Inactivo</span>
                                        }
                                    </td>

                                    <td>
                                        <span class="admin-date-text">
                                            @item.FechaCreacion.ToString("dd/MM/yyyy")
                                        </span>
                                    </td>

                                    <td class="text-center pe-4">
                                        <div class="btn-group admin-actions">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-white border">
                                                <i class="bi bi-pencil-square text-primary"></i>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-white border">
                                                <i class="bi bi-info-circle text-info"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-white border">
                                                <i class="bi bi-trash3 text-danger"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="admin-empty-state">
                                        No se encontraron usuarios.
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="admin-card-footer">
            Total: <strong>@Model.Count()</strong> registros
        </div>
    </div>
</div>