@model IEnumerable<Colore>

@{
    ViewData["Title"] = "Colores";

    var filtroNombre = Context.Request.Query["nombre"].ToString();
    var filtroHex = Context.Request.Query["hex"].ToString();
    var top = Context.Request.Query["top"].ToString();

    if (string.IsNullOrWhiteSpace(top))
    {
        top = "10";
    }
}

<div class="container-fluid px-lg-5 admin-index-page">

    <!-- HERO -->
    <div class="card admin-hero-card">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h1 class="admin-hero-title">
                    <i class="bi bi-palette me-2"></i>Colores
                </h1>
                <p class="admin-hero-subtitle">
                    Administra los colores disponibles en el sistema.
                </p>
            </div>

            <a asp-action="Create" class="btn btn-light admin-btn-main">
                <i class="bi bi-plus-lg me-1"></i> Nuevo color
            </a>
        </div>
    </div>

    <!-- FILTRO -->
    <div class="card admin-filter-card">
        <div class="card-body">
            <form method="get">
                <div class="row g-3 align-items-end">

                    <!-- NOMBRE -->
                    <div class="col-12 col-md-6 col-xl-3">
                        <label class="form-label admin-filter-label">Nombre</label>
                        <div class="input-group shadow-sm admin-filter-group">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-tag text-primary"></i>
                            </span>
                            <input type="text"
                                   name="nombre"
                                   class="form-control"
                                   placeholder="Nombre del color..."
                                   value="@filtroNombre" />
                        </div>
                    </div>

                    <!-- HEX -->
                    <div class="col-12 col-md-6 col-xl-5">
                        <label class="form-label admin-filter-label">Código HEX</label>
                        <div class="input-group shadow-sm admin-filter-group">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-eyedropper text-primary"></i>
                            </span>
                            <input type="text"
                                   name="hex"
                                   class="form-control"
                                   placeholder="Ej: #FF5733"
                                   value="@filtroHex" />
                        </div>
                    </div>

                    <!-- TOP -->
                    <div class="col-12 col-md-4 col-xl-2">
                        <label class="form-label admin-filter-label">Top registros</label>
                        <div class="input-group shadow-sm admin-filter-group">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-list-ol text-primary"></i>
                            </span>
                            <select name="top" class="form-select">
                                <option value="10" selected="@(top == "10")">10</option>
                                <option value="25" selected="@(top == "25")">25</option>
                                <option value="50" selected="@(top == "50")">50</option>
                                <option value="100" selected="@(top == "100")">100</option>
                                <option value="@int.MaxValue">Todos</option>
                            </select>
                        </div>
                    </div>

                    <!-- BOTONES -->
                    <div class="col-12">
                        <div class="admin-filter-actions">

                            <button type="submit" class="btn btn-primary shadow-sm">
                                <i class="bi bi-search me-2"></i>Buscar
                            </button>

                            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                                <i class="bi bi-arrow-clockwise me-2"></i>Limpiar
                            </a>

                        </div>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- TABLA -->
    <div class="card admin-table-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle admin-table">
                <thead>
                    <tr>
                        <th>Color</th>
                        <th>Código HEX</th>
                        <th class="text-center">Estado</th>
                        <th>Creación</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <!-- COLOR VISUAL -->
                                <td class="fw-bold">
                                    <div class="d-flex align-items-center gap-2">
                                        <div style="
                                            width:20px;
                                            height:20px;
                                            border-radius:4px;
                                            border:1px solid #ccc;
                                            background:@item.CodigoHex">
                                        </div>
                                        @item.Nombre
                                    </div>
                                </td>

                                <!-- HEX -->
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @item.CodigoHex
                                    </span>
                                </td>

                                <!-- ESTADO -->
                                <td class="text-center">
                                    @if (item.Estatus == 1)
                                    {
                                        <span class="admin-status-badge admin-status-active">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="admin-status-badge admin-status-inactive">
                                            Inactivo
                                        </span>
                                    }
                                </td>

                                <!-- FECHA -->
                                <td>
                                    @item.FechaCreacion.ToShortDateString()
                                </td>

                                <!-- ACCIONES -->
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm border">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm border">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm border">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">
                                <div class="admin-empty-state">
                                    No hay colores registrados.
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="admin-card-footer">
            Total: <strong>@Model.Count()</strong> colores
        </div>
    </div>

</div>