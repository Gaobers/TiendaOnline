@model DashboardViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/admin/pages/home/index.css" asp-append-version="true" />
}

<div class="admin-index-page admin-home-page">

    <!-- HERO -->
    <div class="admin-home-hero">
        <div class="admin-home-hero__body">
            <div>
                <span class="admin-home-hero__eyebrow">Panel administrativo</span>
                <h1 class="admin-home-hero__title">Bienvenido al dashboard</h1>
                <p class="admin-home-hero__subtitle">
                    Consulta el resumen general de la tienda y accede rápidamente a los módulos principales del sistema.
                </p>
            </div>

            <div class="admin-home-hero__actions">
                <a class="btn btn-primary admin-btn-main"
                       asp-controller="Productos"
                       asp-action="Create">
                    <i class="bi bi-plus-lg me-1"></i>
                    Nuevo producto
                </a>

                <a class="btn btn-outline-primary"
                       asp-controller="Pedidos"
                       asp-action="Index">
                    <i class="bi bi-receipt me-1"></i>
                    Ver pedidos
                </a>
            </div>
        </div>
    </div>

    <!-- KPIs -->
    <div class="row g-3">
        <div class="col-12 col-md-6 col-xl-4">
            <div class="admin-home-kpi-card">
                <div class="card-body">
                    <div class="admin-home-kpi">
                        <div>
                            <div class="admin-home-kpi__label">Productos</div>
                            <div class="admin-home-kpi__value">@Model.TotalProductos</div>
                            <p class="admin-home-kpi__meta">Total disponible en catálogo</p>
                        </div>
                        <div class="admin-home-kpi__icon admin-home-kpi__icon--primary">
                            <i class="bi bi-box-seam"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <div class="admin-home-kpi-card">
                <div class="card-body">
                    <div class="admin-home-kpi">
                        <div>
                            <div class="admin-home-kpi__label">Pedidos</div>
                            <div class="admin-home-kpi__value">@Model.TotalPedidos</div>
                            <p class="admin-home-kpi__meta">Seguimiento general de ventas</p>
                        </div>
                        <div class="admin-home-kpi__icon admin-home-kpi__icon--success">
                            <i class="bi bi-receipt"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <div class="admin-home-kpi-card">
                <div class="card-body">
                    <div class="admin-home-kpi">
                        <div>
                            <div class="admin-home-kpi__label">Usuarios</div>
                            <div class="admin-home-kpi__value">@Model.TotalUsuarios</div>
                            <p class="admin-home-kpi__meta">Clientes y administradores registrados</p>
                        </div>
                        <div class="admin-home-kpi__icon admin-home-kpi__icon--info">
                            <i class="bi bi-people"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CONTENIDO -->
    <div class="row g-3">
        <div class="col-12 col-xl-8">
            <div class="admin-home-section-card">
                <div class="admin-home-section-card__header">
                    <div>
                        <h2 class="admin-home-section-card__title">Productos recientes</h2>
                        <p class="admin-home-section-card__subtitle">
                            Últimos 5 productos registrados en el sistema
                        </p>
                    </div>

                    <a class="btn btn-outline-primary btn-sm"
                           asp-controller="Productos"
                           asp-action="Index">
                        <i class="bi bi-box-seam me-1"></i>
                        Ver todos
                    </a>
                </div>

                @if (Model.ProductosRecientes == null || !Model.ProductosRecientes.Any())
                {
                    <div class="admin-home-empty">
                        No hay productos registrados todavía.
                    </div>
                }
                else
                {
                    <div class="admin-home-products">
                        @foreach (var p in Model.ProductosRecientes)
                        {
                            <div class="admin-home-products__item">
                                <div>
                                    <p class="admin-home-products__name">@p.Nombre</p>
                                    <p class="admin-home-products__desc">
                                        Producto agregado recientemente al catálogo
                                    </p>
                                </div>

                                <div class="admin-home-products__price">
                                    $@p.Precio.ToString("0.00")
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="admin-home-section-card">
                <div class="admin-home-section-card__header">
                    <div>
                        <h2 class="admin-home-section-card__title">Accesos rápidos</h2>
                        <p class="admin-home-section-card__subtitle">
                            Módulos principales del sistema
                        </p>
                    </div>
                </div>

                <div class="admin-home-links">
                    <a class="admin-home-link"
                           asp-controller="Productos"
                           asp-action="Index">
                        <span class="admin-home-link__icon">
                            <i class="bi bi-box-seam"></i>
                        </span>
                        <span class="admin-home-link__text">Gestionar productos</span>
                    </a>

                    <a class="admin-home-link"
                           asp-controller="Pedidos"
                           asp-action="Index">
                        <span class="admin-home-link__icon">
                            <i class="bi bi-receipt"></i>
                        </span>
                        <span class="admin-home-link__text">Gestionar pedidos</span>
                    </a>

                    <a class="admin-home-link"
                           asp-controller="Usuarios"
                           asp-action="Index">
                        <span class="admin-home-link__icon">
                            <i class="bi bi-people"></i>
                        </span>
                        <span class="admin-home-link__text">Gestionar usuarios</span>
                    </a>

                    <a class="admin-home-link"
                           asp-controller="Cupones"
                           asp-action="Index">
                        <span class="admin-home-link__icon">
                            <i class="bi bi-ticket-perforated"></i>
                        </span>
                        <span class="admin-home-link__text">Administrar cupones</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>